# LOCAL ONLY — never commit values. This file lists NAMES and where each one lives.
#
# Two different homes, do not mix them up:
#   · .env.local      → the Vite client and the `convex` CLI on your machine
#   · Convex env      → `npx convex env set NAME value` (server-side, per deployment)
#
# ── Client / CLI (this file, .env.local) ─────────────────────────────────────
# Convex deployment URL the browser talks to. MUST be the same deployment the
# CLI pushes code to, or the UI reads another deployment's data.
VITE_CONVEX_URL=

# Deployment selector used by `npx convex dev` / `npx convex deploy`.
CONVEX_DEPLOYMENT=

# Scoped deploy key for headless deploys. NEVER commit this and never put it in
# .env (Wrangler/Convex tooling reads .env); keep it in .env.deploy or CI secrets.
# CONVEX_DEPLOY_KEY=

# ── Convex deployment env (set with `npx convex env set`) ────────────────────
# OPERATOR THE GATE — comma-separated. Every trading-settings write is REFUSED
# while this is unset, and again if the signed-in email is not in the list. Set
# it BEFORE the first deploy, or the settings UI is dead on arrival.
#   npx convex env set OPERATOR_EMAILS you@example.com
OPERATOR_EMAILS=

# MEXC API keypair for THIS deployment: futures enabled, WITHDRAWAL DISABLED,
# IP-restricted. Never reuse the reference deployment's keypair.
#   npx convex env set MEXC_API_KEY ...
#   npx convex env set MEXC_API_SECRET ...
MEXC_API_KEY=
MEXC_API_SECRET=

# Email OTP relay for sign-in. Server-side only.
#   npx convex env set FREEBUFF_EMAIL_API_KEY ...
FREEBUFF_EMAIL_API_KEY=

# Public site origin used by auth redirects.
#   npx convex env set SITE_URL https://your-app.example
SITE_URL=

# Cron grid master switch. Leave it unset (or "0"/"false") until the kline cache
# is seeded and the deployment is verified: an empty cache silently disables the
# 4h regime and advisor gates.
#   npx convex env set CRONS_ENABLED 1
CRONS_ENABLED=

# Auth key material (see src/convex/auth.config.ts). Generate per deployment;
# never copy the reference deployment's values.
#   npx convex env set JWKS ...
#   npx convex env set JWT_PRIVATE_KEY ...
JWKS=
JWT_PRIVATE_KEY=
